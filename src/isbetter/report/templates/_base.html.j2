{% macro head(title) %}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
:root {
  --bg: #fafaf8; --fg: #1d1d1b; --muted: #5f5f5a; --line: #dcdcd4; --card: #ffffff;
  --good: #1a7f4b; --good-weak: #5b8f3a; --neutral: #5f5f5a; --bad-weak: #b36b00; --bad: #b3261e;
  --band: #e6efe9; --accent: #2b59c3; --warn-bg: #fff4d6; --warn-line: #d9a400;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #161614; --fg: #ececE6; --muted: #a3a39a; --line: #3a3a35; --card: #1f1f1c;
    --good: #5fcf94; --good-weak: #9acb72; --neutral: #a3a39a; --bad-weak: #e8a33d;
    --bad: #ff8a80; --band: #26362d; --accent: #8aa9ff; --warn-bg: #3a3118; --warn-line: #a88512;
  }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--fg);
  font: 16px/1.55 system-ui, -apple-system, "Segoe UI", sans-serif; }
main { max-width: 52rem; margin: 0 auto; padding: 2rem 1rem 4rem; }
h1 { font-size: 1.7rem; margin: 0 0 .2rem; }
h2 { font-size: 1.3rem; margin: 2.2rem 0 .6rem; border-bottom: 1px solid var(--line);
  padding-bottom: .25rem; }
h3, h4 { font-size: 1.1rem; margin: 1.6rem 0 .5rem; }
.meta { color: var(--muted); font-size: .9rem; margin: 0 0 1rem; }
pre { background: var(--card); border: 1px solid var(--line); border-radius: 6px;
  padding: .8rem 1rem; overflow-x: auto; font-size: .85rem; }
code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .88em; }
.card { background: var(--card); border: 1px solid var(--line); border-radius: 8px;
  padding: 1rem 1.1rem; margin: 1rem 0; }
.badge { display: inline-block; font-weight: 600; border: 1.5px solid currentColor;
  border-radius: 999px; padding: .1rem .75rem; font-size: .95rem; }
.badge.good { color: var(--good); } .badge.good-weak { color: var(--good-weak); }
.badge.neutral { color: var(--neutral); } .badge.bad-weak { color: var(--bad-weak); }
.badge.bad { color: var(--bad); }
.table-wrap { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; font-size: .93rem; margin: .6rem 0; }
th, td { text-align: left; padding: .35rem .6rem; border-bottom: 1px solid var(--line);
  vertical-align: top; }
th { color: var(--muted); font-weight: 600; }
td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
.warning { background: var(--warn-bg); border-left: 4px solid var(--warn-line);
  padding: .5rem .8rem; margin: .6rem 0; border-radius: 0 6px 6px 0; }
.why { color: var(--muted); }
svg.interval { width: 100%; max-width: 560px; height: auto; display: block; margin: .4rem 0; }
svg.interval .band { fill: var(--band); }
svg.interval .zero { stroke: var(--muted); stroke-width: 1; stroke-dasharray: 4 3; }
svg.interval .ci { stroke: var(--accent); stroke-width: 2.5; }
svg.interval .est { fill: var(--accent); }
svg.interval text { fill: var(--muted); font-size: 11px; }
.figcap { color: var(--muted); font-size: .82rem; margin: 0 0 .6rem; }
footer { color: var(--muted); font-size: .85rem; margin-top: 3rem; }
@media print { body { background: #fff; color: #000; } .card { break-inside: avoid; } }
</style>
</head>
<body>
<main>
{% endmacro %}
{% macro foot() %}
<footer>Generated by isbetter. Estimates are candidate &minus; baseline.</footer>
</main>
</body>
</html>
{% endmacro %}
